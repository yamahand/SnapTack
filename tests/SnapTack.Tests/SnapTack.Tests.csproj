<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WPF 本体 (SnapTack) を参照して検証する分だけを置く。現状は UI 文字列リソース
      (Resources/Strings.resx と手書きアクセサ) の検証のみ。
      Windows 非依存のロジックは tests/SnapTack.Core.Tests (net10.0) 側にある。
      WPF アセンブリを参照するため -windows TFM と UseWPF が必要。
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SnapTack\SnapTack.csproj" />
  </ItemGroup>

</Project>
