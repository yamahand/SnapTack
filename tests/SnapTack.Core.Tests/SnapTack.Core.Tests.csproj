<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Windows 非依存のロジックを検証する。SnapTack.Core だけを参照し、TFM を net10.0 に保つ
      ことで「Core が本当に Windows 依存を持っていないか」がビルドで担保される
      (WPF 型が混入すると参照が解決できずここで落ちる)。
      WPF 側のリソース・グルーの検証は tests/SnapTack.Tests (net10.0-windows) が担う。
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SnapTack.Core\SnapTack.Core.csproj" />
  </ItemGroup>

</Project>
